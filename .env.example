# career-ops — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# ── Gemini Integration ────────────────────────────────────────────────────────
# Required for: node gemini-eval.mjs "JD text here"
# Free API key: https://aistudio.google.com/apikey
# Free tier: rate-limited usage with gemini-3.6-flash (no billing needed)
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: Override default Gemini model ───────────────────────────────────
# Default: gemini-3.6-flash (stable Flash)
# Alternatives: gemini-3.5-flash, gemini-2.5-pro
# GEMINI_MODEL=gemini-3.6-flash

# ── OpenRouter Integration (openrouter-runner.mjs — no-CLI, $0 free tier) ─────
# Required for: node openrouter-runner.mjs
# Free API key: https://openrouter.ai → Sign Up → Keys
# Free tier: hundreds of models at $0 cost
OPENROUTER_API_KEY=sk-or-v1-paste-your-key-here

# Optional: pin a specific model instead of using auto-rotation.
# When set, the runner uses this model directly and skips blacklist/rotation.
# Model names are fetched live from the OpenRouter API at runtime — no hardcoding.
# CAREER_OPS_MODEL=google/gemini-2.5-pro:free

# ── OpenAI-compatible eval (openai-eval.mjs) ─────────────────────────────────
# Evaluate offers with ANY OpenAI-compatible endpoint (OpenAI, OpenRouter,
# Together, Groq, DeepSeek, Zhipu GLM, LM Studio, llama.cpp, vLLM, Ollama /v1).
# Required for: node openai-eval.mjs "JD text here"
# OPENAI_API_KEY=your_provider_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1   # e.g. https://openrouter.ai/api/v1
# OPENAI_MODEL=gpt-4o-mini                     # e.g. deepseek/deepseek-chat

# ── Other integrations (add your own below) ──────────────────────────────────
# ANTHROPIC_API_KEY=your_anthropic_key_here   # For Claude-based workflows

# ── Daily Operational Loop (opt-in; disabled unless explicitly enabled) ───────
# CAREER_OPS_SHEET_ID=your_google_spreadsheet_id
# Production Workspace auth: Cloud Run metadata identity -> IAM signBlob -> DWD.
# No local Google user credential or service-account JSON key is required.
GOOGLE_SHEETS_AUTH_MODE=workspace_broker
CAREER_OPS_PRODUCTION=true
CAREER_OPS_WORKSPACE_BROKER_URL=https://your-workspace-auth-broker.run.app
CAREER_OPS_WORKSPACE_BROKER_SECRET=replace-with-secret-manager-value
GOOGLE_REMOTE_SIGNER_SERVICE_ACCOUNT=workspace-agent@project.iam.gserviceaccount.com
GOOGLE_IMPERSONATION_SUBJECT=workspace-user@example.com
# Development-only interactive mode (never use for production LaunchAgents):
# GOOGLE_SHEETS_AUTH_MODE=application_default
# Unattended keyless path (ADC source -> IAM remote signer -> Workspace DWD):
# GOOGLE_SHEETS_AUTH_MODE=iam_remote_signing
# GOOGLE_REMOTE_SIGNER_SERVICE_ACCOUNT=service-account@project.iam.gserviceaccount.com
# GOOGLE_IMPERSONATION_SUBJECT=user@your-domain.example
# GOOGLE_SHEETS_SCOPES=https://www.googleapis.com/auth/spreadsheets
# Legacy private-key DWD path (use only when explicitly authorized):
# GOOGLE_SHEETS_AUTH_MODE=service_account_impersonation
# GOOGLE_MACHINE_CREDENTIALS_FILE=config/google-service-account.json
# GOOGLE_IMPERSONATION_SUBJECT=user@your-domain.example
# GOOGLE_SHEETS_SCOPES=https://www.googleapis.com/auth/spreadsheets
# Optional private Desktop OAuth client used by `npm run google:auth -- authorize`.
# Keep the JSON git-ignored and authorize the Brunova Google account for Sheets.
# GOOGLE_OAUTH_CLIENT_FILE=config/google-oauth-client.json
# Alternative for a secure environment provider:
# GOOGLE_SHEETS_AUTH_MODE=oauth_env
# GOOGLE_OAUTH_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-desktop-client-secret
# GOOGLE_OAUTH_REFRESH_TOKEN=your-refresh-token
# CAREER_OPS_DASHBOARD_URL=https://docs.google.com/spreadsheets/d/your_google_spreadsheet_id/edit
# CAREER_OPS_NOTIFICATIONS_ENABLED=true
# CAREER_OPS_DAILY_COMPLETION_SUMMARY=true
# CAREER_OPS_WORKFLOW_DIGESTS=true
# CAREER_OPS_NOTIFICATION_HOURLY_LIMIT=5
# CAREER_OPS_EMAIL_PROVIDER=resend
# RESEND_API_KEY=your_resend_api_key_here
# CAREER_OPS_EMAIL_FROM=Career Ops <career@brunova.mx>
# CAREER_OPS_EMAIL_TO=jorgeaveraf@gmail.com
# CAREER_OPS_NOTIFICATION_RECIPIENT=jorgeaveraf@gmail.com
# CAREER_OPS_NOTIFY_NEEDS_HUMAN=true
# CAREER_OPS_NOTIFY_READY_FOR_REVIEW=true
# CAREER_OPS_NOTIFY_APPLICATION_CONFIRMED=true
# CAREER_OPS_NOTIFY_APPLICATION_FAILED=true
# CAREER_OPS_NOTIFY_COMMAND_FAILED=true
# CAREER_OPS_NOTIFY_ENRICHMENT_BLOCKED=true
# CAREER_OPS_TIMEZONE=America/Mexico_City
# CAREER_OPS_SCHEDULE_HOUR=16
# CAREER_OPS_SCHEDULE_MINUTE=0
# CAREER_OPS_LOG_DIR=logs
# CAREER_OPS_BACKUP_ENABLED=true
# CAREER_OPS_BACKUP_DIR=backups/sqlite
# CAREER_OPS_BACKUP_KEEP=30
# CAREER_OPS_MIN_FREE_DISK_MB=1024

# ── Browser Research (research-only; separate 16:00 window) ─────────────────
# Required for a real Browser Research run. The directory must be the existing
# Chrome user-data root whose Local State maps exactly one profile name to Jorge.
BROWSER_PROFILE=jorge
BROWSER_MODE=research_only
# BROWSER_USER_DATA_DIR=/absolute/path/to/existing/chrome/user-data
# BROWSER_RESEARCH_CONFIG=config/browser-research.json
# BROWSER_SESSION_NAME=career_ops
# BROWSER_SESSION_KIND=managed_window
# BROWSER_SESSION_LOCK=data/browser/.careerops-session.lock
# BROWSER_RESEARCH_SCHEDULE_HOUR=15
# BROWSER_RESEARCH_SCHEDULE_MINUTE=30

# ── Application Execution Browser (separate exact-authorization capability) ──
# APPLICATION_EXECUTION_BROWSER_ENABLED=true
# Canonical platform-registration identity is fixed in code to fubifo@gmail.com.
# Set true only after the Jorge Chrome profile can open that exact Gmail inbox.
# PLATFORM_SIGNUP_GMAIL_READY=false
# APPLICATION_BROWSER_PROFILE=jorge
# APPLICATION_BROWSER_MODE=application_submit
# APPLICATION_BROWSER_USER_DATA_DIR=/absolute/path/to/existing/chrome/user-data
# APPLICATION_BROWSER_SESSION_LOCK=data/browser/.careerops-application-session.lock

# ══════════════════════════════════════════════════════════════════════════════
# Plugins (opt-in) — keys for bundled plugins. Enable each in config/plugins.yml.
# Plugins are OFF by default; the core needs none of these. See plugins/README.md.
# ══════════════════════════════════════════════════════════════════════════════

# ── apify plugin (provider) ── keyed job source via an Apify actor
# Token: https://console.apify.com/account/integrations
# APIFY_TOKEN=apify_api_paste-your-token-here

# ── notion plugin (export + search) ── mirror your tracker to a Notion DB
# Integration token: https://www.notion.so/my-integrations
# NOTION_ACCESS_TOKEN=ntn_paste-your-internal-integration-secret
# NOTION_PARENT_PAGE_ID=your-notion-parent-page-id

# ── gmail plugin (ingest) ── pull job leads from a Gmail label
# OAuth client (Desktop) + a refresh token from the consent flow:
# https://console.cloud.google.com/apis/credentials
# GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your-client-secret
# GMAIL_REFRESH_TOKEN=your-refresh-token
# V3A event delivery. The local subscriber pulls through the authenticated command
# gateway and has no local Google credential dependency.
GOOGLE_CLOUD_PROJECT=brunova-ai-platform
CAREER_OPS_PUBSUB_SUBSCRIPTION=career-ops-local
CAREER_OPS_LEGACY_TRANSPORT=disabled
# V3E bounded operational intelligence (5-minute native watcher)
CAREER_OPS_OPERATIONAL_WATCH_ENABLED=false
CAREER_OPS_COMMAND_GATEWAY_URL=https://your-cloud-run-service.run.app
CAREER_OPS_COMMAND_SUBSCRIBER_PROVIDER=command_gateway_pull
CAREER_OPS_COMMAND_SECRET=replace-with-command-gateway-hmac-secret
CAREER_OPS_OPERATIONAL_WATCH_LOCK=data/.operational-watch.lock
CAREER_OPS_NOTIFY_OPERATIONAL_ESCALATION=true
# Immediate NEXT_STAGE drain bounds; the 17:00 LaunchAgent remains a safety sweep.
CAREER_OPS_ENRICHMENT_MAX_ITEMS=10
CAREER_OPS_ENRICHMENT_MAX_RUNTIME_MINUTES=30
CAREER_OPS_STARTUP_GRACE_MS=120000
# Autonomous candidate outreach (candidate Gmail credentials remain isolated under data/auth by default)
LINKEDIN_OUTREACH_ENABLED=false
CANDIDATE_GMAIL_CREDENTIALS_FILE=data/auth/candidate-gmail/application_default_credentials.json
